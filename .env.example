# Text dialogue and simulated voice input work without keys.
# Real microphone input requires STT_API_KEY or OPENAI_API_KEY in both modes.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
# Optional independent OpenAI-compatible speech recognition service.
# Leave empty to fall back to OPENAI_API_KEY / OPENAI_BASE_URL.
STT_API_KEY=
STT_BASE_URL=
TTS_MODEL=tts-1
TTS_VOICE=nova
