# 文字演示与模拟语音输入无需密钥。
# 两种模式的实际录音均需 STT_API_KEY 或 OPENAI_API_KEY。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
# 可独立配置兼容的语音识别服务。
# 留空时复用 OPENAI_API_KEY 与 OPENAI_BASE_URL。
STT_API_KEY=
STT_BASE_URL=
TTS_MODEL=tts-1
TTS_VOICE=nova
# 可独立使用其他兼容语音合成平台，留空复用通用服务配置。
TTS_API_KEY=
TTS_BASE_URL=
